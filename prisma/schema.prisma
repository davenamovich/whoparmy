generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Whop user anchor ───────────────────────────────────────────────
// whopId is the canonical identity field. When real Whop OAuth is
// connected, whopId is set from the verified Whop token — client-supplied
// IDs are never trusted for authorization (see src/lib/auth.ts).
model User {
  id             String   @id @default(cuid())
  whopId         String?  @unique
  whopUsername   String? // preferred_username from Whop OAuth userinfo
  whopAvatarUrl  String? // picture from Whop OAuth userinfo
  email          String   @unique
  name           String?
  plan           String   @default("FREE") // FREE | CREATOR | PRO | AGENCY
  planSource     String   @default("default") // default | whop_membership | whop_access | manual
  planUpdatedAt  DateTime?
  memeArmyPlan   String? // CUSTOM | AGENCY (premium upsell)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brands       BrandProfile[]
  campaigns    Campaign[]
  usageRecords UsageRecord[]
  bridgeConnection BridgeConnection?
  bridgeCodes  BridgeCode[]
  telegramPairCodes TelegramPairCode[]
  bridgeTokens BridgeToken[]
  bridgeUpdateTokens BridgeUpdateToken[]
  researchJobs ResearchJob[]
  videoJobs    VideoJob[]
  engineLinks  EngineLink[]
  linkClicksOwned LinkClick[] @relation("LinkClickOwner")
  rotatorBids  RotatorBid[]
  rotatorWins  RotatorDay[] @relation("RotatorWins")
  rotatorPlacements RotatorPlacement[]
  trafficDays  AgentTrafficDay[]
  linksSavedAt DateTime? // first bridge link save — pays the referrer's free generations (lib/bridge.ts)
  // BTC Experiment (Flow v2, 2026-11-19): PUBLIC receive addresses
  // only — receive-only, never a seed phrase or private key. The
  // agent address is the payout address the member enters on DH
  // Media at registration (lib/btc-addresses.ts).
  btcReceiveAddress String?
  agentBtcAddress   String?
  assets       Asset[]
  jobs         GenerationJob[]
  army         ArmyBot?
  gameProfile  GameProfile?
  xpEvents     XpEvent[]
  hiredAgents  HiredAgent[]
  agentJobs    AgentJob[]
  applications Application[]
  listings     CampaignListing[]
  doorsSessions DoorsSession[]
  bidPointEvents BidPointEvent[]
  keyBids      KeyBid[]
  keyAuctionWins KeyAuction[] @relation("KeyWins")

  // Referral program (30%): every member gets a code; attribution is
  // set once, never overwritten. Earnings accrue in ReferralEarning.
  refCode      String?  @unique
  referredById String?
  // Free generations earned from referrals (lib/referrals.ts): granted
  // on a referral's conversion, spent automatically once the plan's
  // monthly allowance is used up (lib/usage-server.ts applyFreeGens).
  freeGenBalance Int     @default(0)
  freeGenMonth   String? // YYYY-MM the applied counter belongs to
  freeGenApplied Int     @default(0)
  referredBy   User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]   @relation("Referrals")
  earnings     ReferralEarning[] @relation("Earner")
  earnedFrom   ReferralEarning[] @relation("Recruit")

  clipPages    ClipPage[]
  clipJobs     ClipJob[]
  userRotator UserRotator?
  agentRotators AgentRotator[]
  identityLinks IdentityLink[]
  pendingReferralsMade PendingReferral[] @relation("PendingReferrer")
  agentWallets AgentWallet[]
}

// ─── Brand profiles (multiple allowed for agencies) ─────────────────
model BrandProfile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  website     String?
  industry    String?
  description String?
  products    String?
  audience    String?
  voice       String?
  languages   String   @default("[\"en\"]")
  cta         String?
  links       String?
  researchJson String? // P&R deep-research summary (slice 3), JSON-encoded ResearchSummary
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Content campaigns ──────────────────────────────────────────────
model Campaign {
  id              String   @id @default(cuid())
  userId          String
  name            String
  businessName    String
  website         String?
  sourceType      String   @default("URL") // URL | DESCRIPTION | IDEA | BRAND
  profileJson     String   @default("{}") // business profile snapshot
  objective       String
  customObjective String?
  tone            String
  customTone      String?
  languages       String   @default("[\"en\"]") // JSON array of codes
  formats         String   @default("[]") // JSON array of {category, format}
  piecesPerFormat Int      @default(2)
  status          String   @default("GENERATING") // GENERATING | COMPLETE | PARTIAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]
  jobs   GenerationJob[]

  @@index([userId])
}

// ─── Generated content assets ───────────────────────────────────────
model Asset {
  id            String   @id @default(cuid())
  userId        String
  campaignId    String?
  type          String // MEME | SOCIAL | VIDEO | AUDIO | MARKETING
  format        String // machine key e.g. facebook_post
  formatLabel   String // human label e.g. "Facebook Post"
  language      String   @default("en")
  languageLabel String   @default("English")
  title         String   @default("")
  body          String   @default("")
  topText       String?
  bottomText    String?
  imageUrl      String?
  pageUrl       String? // engine temp page for engine-generated memes (slice 2)
  engineRef     String? // engine page id, for status / render follow-ups
  objective     String?
  tone          String?
  status        String   @default("PENDING") // PENDING | GENERATING | DONE | FAILED
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campaignId])
}

// ─── Generation jobs (progress tracking, no duplicate billing) ──────
model GenerationJob {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String
  status      String   @default("QUEUED") // QUEUED | RUNNING | COMPLETE | FAILED
  total       Int      @default(0)
  done        Int      @default(0)
  failed      Int      @default(0)
  currentStep String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Whop webhook idempotency (retries repeat webhook-id; never reprocess) ─
model WebhookEvent {
  id        String   @id // Whop `webhook-id` header value (msg_...)
  type      String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Usage accounting (failed generations are never charged) ────────
model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  kind      String // TEXT | IMAGE | FAILED
  count     Int      @default(1)
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── WAR ROOM — gamified Bifrost layer ──────────────────────────────
// The member's game identity. XP comes only from real work events
// (packs generated, campaigns created) recorded in XpEvent — never
// from page views or clicks. Energy is NOT stored: it is the plan's
// monthly allowance read against UsageRecord (see src/lib/game.ts).
model GameProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  xp           Int      @default(0)
  streakDays   Int      @default(0)
  lastActiveOn String? // YYYY-MM-DD (UTC) of the last XP-earning day
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String // PACK_GENERATED | CAMPAIGN_CREATED | SMART_ROUTE
  amount    Int
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, kind])
}

// ─── AGENT ECONOMY — hire agents with tokens ────────────────────────
// A member allocates weighted tokens from their plan wallet to a hired
// agent. Jobs are charged against that allocation at the model's real
// weighted cost (see MODEL_TIERS in src/lib/game.ts). Jobs sit QUEUED
// until the agent's Agent37 slot executes them — the queue never fakes
// completion. Campaign bounties are reserved from the poster's wallet
// and stay SIMULATED value until real payments exist.
model HiredAgent {
  id          String    @id @default(cuid())
  userId      String
  templateKey String // scout | meme-smith | hook-smith | qa-editor
  name        String
  tokenBudget Int // weighted tokens allocated from the plan wallet
  tokensUsed  Int       @default(0)
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | DEPLETED
  source      String    @default("RENTAL") // RENTAL (a plan seat) | REFERRAL (24h earned bot — not a seat)
  expiresAt   DateTime? // REFERRAL bots only: the grant dies at this instant
  agent37Ref  String? // Agent37 instance/session ref once provisioned
  role         String? // SMB Agent Factory (2026-11-18): the agent's job in plain words
  instructions String? // Factory: the agent's standing instructions (CUSTOM kind runs on these)
  toolsJson    String? // Factory: JSON array of selected tools [{id,label,kind}]
  // Whop Army 2.0 Slice 2 (2026-11-21): public agent profile. All
  // nullable/defaulted — a profile exists only when publicProfile is
  // true AND slug is set; nothing here is exposed until then.
  slug           String?  @unique // public /agent/{slug} path segment
  publicProfile  Boolean  @default(false)
  avatarUrl      String?
  description    String? // one-line public description
  category       String? // one of AGENT_CATEGORIES (lib/agent-profile.ts)
  capabilitiesJson String? // JSON array of capability strings
  demoUrl        String?
  appUrl         String?
  gitUrl         String?
  buildPrompt    String?
  spaceUrl       String? // Muse Space URL where applicable
  // Agent card upgrade (2026-11-21): Bankr token + proceeds preference.
  // The token address is paste-and-save by the owner AFTER launching on
  // Bankr in their own session — this app never launches, never holds
  // keys, never writes to a wallet. The proceeds fields are a RECORDED
  // owner instruction (shown on the card), not automation: execution
  // stays in Bankr by the owner's own hand until a write integration
  // is separately approved.
  bankrTokenAddress    String?
  bankrTokenChain      String? // EVM | SOLANA (derived from the address shape at save time)
  proceedsToCoin       Boolean @default(false)
  proceedsToCoinPct    Int     @default(0) // 0–100
  proceedsToCoinTarget String  @default("BTC") // BTC | TOKEN (TOKEN needs a saved bankrTokenAddress)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs AgentJob[]
  trafficDays AgentTrafficDay[]
  agentRotator AgentRotator?
  applications Application[]
  wallets AgentWallet[]

  @@index([userId])
}

// ─── Applications built by an agent (Whop Army 2.0, Slice 3) ───────
// A public showcase entry: an app a HiredAgent built, listed on the
// agent's public profile and in /apps once the owner marks it public.
// userId is the owner's id denormalized from the agent so ownership
// checks (session CRUD + bridge-token publish) never need a join.
// Nothing here is exposed until public is true AND the app has a slug;
// serialization goes through lib/application.ts only.
model Application {
  id             String   @id @default(cuid())
  agentId        String
  userId         String
  slug           String   @unique // public /apps/{slug} path segment
  name           String
  description    String? // one-line public description
  liveUrl        String? // live demo / public URL
  screenshotUrl  String?
  repoUrl        String? // source repository
  buildPrompt    String?
  public         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@index([public])
}

model AgentJob {
  id        String   @id @default(cuid())
  hireId    String
  userId    String
  kind      String // SCOUT | MEME | HOOK | QA | CAMPAIGN
  brief     String
  language  String   @default("en") // selected OUTPUT language (content catalog code): any language in, selected language out
  pieces    Int      @default(1)
  tokenCost Int // weighted tokens charged to the hire's allocation
  status    String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELLED
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hire HiredAgent @relation(fields: [hireId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hireId])
}

model CampaignListing {
  id           String   @id @default(cuid())
  posterId     String
  title        String
  description  String
  bountyTokens Int // weighted tokens reserved from the poster's wallet
  status       String   @default("OPEN") // OPEN | ASSIGNED | COMPLETED | CANCELLED
  assigneeId   String? // HiredAgent id that claimed it
  jobId        String? // AgentJob created by the claim; settlement keys off the listing status transition
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  poster User @relation(fields: [posterId], references: [id], onDelete: Cascade)

  @@index([posterId])
  @@index([status])
}

// ─── REFERRAL PROGRAM — 30% ─────────────────────────────────────────
// One row per conversion: a referred member's first bot rental earns
// their referrer 30% of the recruit's plan price. Status stays
// SIMULATED until payouts run on a real rail (Whop affiliate payouts
// are the operator's dashboard step) — never present these as paid.
model ReferralEarning {
  id          String   @id @default(cuid())
  referrerId  String
  recruitId   String   @unique // one conversion per recruit, ever
  basisPlan   String // recruit's plan key at conversion
  amountCents Int // 30% of the plan price, in cents
  status      String   @default("SIMULATED") // QUALIFYING | SIMULATED | PAYABLE | PAID
  createdAt   DateTime @default(now())

  referrer User @relation("Earner", fields: [referrerId], references: [id], onDelete: Cascade)
  recruit  User @relation("Recruit", fields: [recruitId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// ─── LLM ROUTING POLICY — operator console ──────────────────────────
// One row per tier the operator has overridden from the LLM Control
// console. No row = the code default (MODEL_TIERS in lib/game.ts).
// The agent runner reads these on every job, so a policy change takes
// effect on the next job — no redeploy.
model RoutingPolicy {
  tier      String   @id // volume | mid | final | quality
  model     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── P&R MEME ARMY — multi-tenant Telegram bot engine ───────────────
model ArmyBot {
  id            String   @id @default(cuid())
  userId        String   @unique // one army per owner in this build
  armyName      String
  slug          String   @unique // secret webhook path segment
  logoUrl       String?
  colorPrimary  String   @default("#FF5C1A")
  colorSecondary String  @default("#111111")
  website       String?
  botToken      String // stored server-side only, never returned to client
  botUsername   String?
  telegramBotId String?
  webhookUrl    String?
  webhookStatus String   @default("PENDING") // PENDING | ACTIVE | FAILED
  secretToken   String? // Telegram webhook secret header check
  groupId       String?
  groupTitle    String?
  languages     String   @default("[\"en\",\"es\"]")
  welcomeMessage String?
  rewardsJson   String   @default("[]") // [{name,type,cost,description}]
  status        String   @default("DRAFT") // DRAFT | LIVE | PAUSED
  demoSeeded    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions Mission[]
  members ArmyMember[]
  submissions Submission[]

  @@index([userId])
}

model Mission {
  id               String   @id @default(cuid())
  botId            String
  title            String
  product          String?
  description      String
  targetUrl        String?
  audience         String?
  languages        String   @default("[\"en\"]")
  durationDays     Int      @default(7)
  dailyRequirement String?
  rewardBudget     String?
  rules            String?
  contentPackJson  String   @default("[]") // approved, ready-to-share items
  status           String   @default("DRAFT") // DRAFT | LIVE | ENDED
  announcedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bot         ArmyBot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([botId])
}

model ArmyMember {
  id            String   @id @default(cuid())
  botId         String
  telegramId    String
  username      String?
  displayName   String
  language      String   @default("en")
  points        Int      @default(0)
  shares        Int      @default(0)
  referrals     Int      @default(0)
  clicks        Int      @default(0)
  verifiedClicks Int     @default(0)
  badges        String   @default("[]")
  isDemo        Boolean  @default(false)
  refCode       String?
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bot         ArmyBot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([botId, telegramId])
  @@index([botId])
}

model Submission {
  id        String   @id @default(cuid())
  botId     String
  missionId String?
  memberId  String
  kind      String   @default("LINK") // MEME | POST | VIDEO | LINK
  payload   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  bot     ArmyBot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  mission Mission?    @relation(fields: [missionId], references: [id], onDelete: SetNull)
  member  ArmyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([missionId])
}

// ─── Brand deep-research background jobs ─────────────────────────────
// research_brand takes ~2 minutes — far too long for one blocking
// request. A job row is created instantly, the work runs detached in
// the server process, and clients poll. Result holds the full
// AnalyzeResponse JSON so consumers use it exactly like the old
// synchronous analyze payload.
model VideoJob {
  id          String   @id @default(cuid())
  userId      String
  format      String // BEST_OF | RIDICULOUS | NEWS | PRESENT | BEFORE_PACK | FUNNEL | SCROLL | INFOMERCIAL | FOLLOWUP
  paramsJson  String // the submit arguments the member chose (brief, links, offer url, source job…)
  status      String   @default("RUNNING") // RUNNING | DONE | FAILED
  engineJobId String? // engine job id (sitdown/scroll/infomercial/funnel/demo_pack); null for synchronous followups
  engineKind  String? // get_job_status kind for polling
  pageUrl     String? // the finished preview page
  shareUrl    String? // funnel bestof day-pack share page
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ResearchJob {
  id         String   @id @default(cuid())
  userId     String
  brandName  String
  website    String
  status     String   @default("running") // running | done | failed
  resultJson String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, website])
  @@index([userId, createdAt])
}

// ─── Bridge links ────────────────────────────────────────────────────
// The member's own referral links for the ecosystem partners, saved
// on the /bridge landing page (the start of building their own
// engine). The FIRST save is an onboarding event: it pays the
// member's referrer free generations (see lib/bridge.ts).
model EngineLink {
  id        String   @id @default(cuid())
  userId    String
  partner   String // canonical key = the P&R MCP step (lib/offer-catalog.ts); legacy keys migrated at boot
  url       String
  source    String   @default("manual") // "manual" (typed on /bridge) | "pr-mcp" (synced from the member's own list_my_offers via the bridge)
  externalRef String? // the member's affiliate id extracted from the link (fpr/ref/via/affid/code/… or Temu /k/<id>)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatorLinks UserRotatorLink[]
  agentRotatorLinks AgentRotatorLink[]

  @@unique([userId, partner])
  @@index([userId])
}

model UserRotator {
  id        String   @id @default(cuid())
  userId    String   @unique
  mode      String   @default("WEIGHTED") // SEQUENTIAL | WEIGHTED
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links UserRotatorLink[]
}

model UserRotatorLink {
  id           String  @id @default(cuid())
  rotatorId    String
  engineLinkId String
  weight       Int     @default(1)
  dailyCap     Int?
  position     Int     @default(0)
  enabled      Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rotator    UserRotator @relation(fields: [rotatorId], references: [id], onDelete: Cascade)
  engineLink EngineLink  @relation(fields: [engineLinkId], references: [id], onDelete: Cascade)

  @@unique([rotatorId, engineLinkId])
  @@index([rotatorId])
}

model AgentRotator {
  id        String   @id @default(cuid())
  agentId   String   @unique
  userId    String
  mode      String   @default("WEIGHTED")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  links AgentRotatorLink[]

  @@index([userId])
}

model AgentRotatorLink {
  id           String   @id @default(cuid())
  rotatorId    String
  engineLinkId String
  weight       Int      @default(1)
  dailyCap     Int?
  position     Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rotator    AgentRotator @relation(fields: [rotatorId], references: [id], onDelete: Cascade)
  engineLink EngineLink   @relation(fields: [engineLinkId], references: [id], onDelete: Cascade)

  @@unique([rotatorId, engineLinkId])
  @@index([rotatorId])
}

model RotatorHop {
  id           String   @id @default(cuid())
  ts           DateTime @default(now())
  surface      String   // USER | AGENT | ALLOCATOR (S1 only writes USER)
  rotatorId    String?
  agentId      String?
  userId       String?
  linkId       String?
  code         String
  ipHash       String?
  uaFamily     String?
  refererHost  String?
  filtered     Boolean  @default(false)
  filterReason String?
  counted      Boolean  @default(true)

  @@index([rotatorId, ts])
  @@index([userId, ts])
}

// ─── Rotator enforcement ladder (Dave, 2026-11-20) ──────────────────
// Enforcement follows the agent first: operators can warn, throttle,
// forfeit slots, or remove an agent or member without rewriting hops.
model RotatorEnforcement {
  id        String    @id @default(cuid())
  scope     String   // AGENT | USER
  scopeId   String   // HiredAgent.id when scope is AGENT; User.id when scope is USER
  level     String   // WARN | THROTTLE | FORFEIT | REMOVED
  reason    String
  createdBy String   // operator User.id who applied it
  createdAt DateTime  @default(now())
  liftedAt  DateTime?

  @@index([scope, scopeId])
  @@index([liftedAt])
}

// ─── Link clicks (Dave, 2026-11-19) ─────────────────────────────────
// One row per REAL click the app itself served: a member tapping
// "Sign up" on their Your Links page (source "signup", credited to
// the referrer whose link was served — ownerUserId null when the
// house link was served) and a no-ref visitor following the rotator
// (source "rotator", credited to the member whose link the rotator
// featured at that moment). This is the member dashboard's click
// count — clicks the app never served are never invented here.
model LinkClick {
  id            String   @id @default(cuid())
  ownerUserId   String? // member whose link was clicked; null = house link
  partner       String // BRIDGE_PARTNERS key
  source        String // signup | rotator
  visitorUserId String? // signed-in clicker when known (signup clicks)
  createdAt     DateTime @default(now())

  owner User? @relation("LinkClickOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([partner])
}

// ─── Muse bridge connector (Dave, 2026-11-17) ──────────────────────
// The member's own Muse calls the P&R MCP through
// whop.plunderandriffle.com/api/bridge/mcp, linked to THIS user.
// Identity + credits live bot-side: the bot's Whop bridge
// (POST /api/bridge/whop/key) derives one agent key per Whop user;
// this app fetches it server-to-server and NEVER stores it — the
// rows below hold only status snapshots, hashes and budgets.
// See lib/muse-bridge.ts and ~/workspace/whoparmy/BRIDGE-CONNECTOR-DESIGN.md.
model BridgeConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  botPlan       String // free | creator | pro — the bot bridge's plan names
  period        String? // last grant period the bot reported (e.g. paid:2026-11-01)
  credits       Int? // last known P&R balance snapshot (display only; the bot is the source of truth)
  granted       Int? // credits granted by the last key fetch
  status        String    @default("ACTIVE") // ACTIVE | BLOCKED | UNCONFIGURED
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time code the member generates on /muse-week and pastes to their
// Muse inside the one command. Only its SHA-256 is stored.
model BridgeCode {
  id            String    @id @default(cuid())
  userId        String
  codeHash      String    @unique
  budgetCredits Int // the budget this code will approve on exchange
  scope         String    @default("week") // week (the /muse-week offer) | clips (Clip Factory, any plan on own credits)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The 7-day bridge token (prb_…) the member's Muse holds. Only its
// SHA-256 is stored. spentCredits is settled from the engine's own
// credit deltas after every generating call, never from estimates.
model BridgeToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  budgetCredits Int
  scope         String    @default("week") // inherited from the code it was exchanged from; enforced on every MCP call
  spentCredits  Int       @default(0)
  pendingCredits Int      @default(0) // budget reserved by in-flight proxied calls; settled or released exactly once per call
  pendingSince  DateTime? // when the oldest live reservation was placed (stale-reservation sweep)
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Permanent update-only bridge credential (pru_…). Only its SHA-256 is stored.
model BridgeUpdateToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Daily rotator auction (Dave, 2026-11-17) ──────────────────────
// Traffic that arrives with no referrer ("no sign up link") is sent
// to ONE destination per ET day. That day's slot is an AUCTION: members
// bid free generations to feature one of their own saved bridge links;
// an admin (operator) confirms the winner. The winning URL is
// snapshotted from the winner's saved EngineLink at confirm time —
// never taken from bid input — so attribution is exact and auditable.
// Unsold days fall back to a deterministic house-offer rotation.
model RotatorDay {
  id            String    @id @default(cuid())
  date          String    @unique // ET calendar day, yyyy-mm-dd
  status        String    @default("OPEN") // OPEN | CONFIRMED | CANCELLED
  winnerUserId  String?
  winnerPartner String?
  winnerUrl     String?
  winningBid    Int?
  gensDeducted  Boolean   @default(false)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  winner User?        @relation("RotatorWins", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids   RotatorBid[]
}

model RotatorBid {
  id        String   @id @default(cuid())
  dayId     String
  userId    String
  partner   String // BRIDGE_PARTNERS key — which of the member's saved links is featured
  amount    Int // free generations bid; deducted only when an admin confirms this bid the winner
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day  RotatorDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dayId, userId])
}

// ─── Affiliate Manager: free rotator placements ─────────────────────
// Dave's rule (2026-11-17): signing up for an offer earns 24 hours
// free in the rotator for THAT offer. A "signup" the app can observe
// is the member saving their own link for the partner (the bridge).
// One placement per offer per member, EVER (the unique row is the
// grant record), scheduled for the next ET day, featuring the
// member's CURRENT saved link for that partner (re-read at serve
// time; a deleted link simply drops out of that day's pool).
model RotatorPlacement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   String // BRIDGE_PARTNERS key
  date      String // ET yyyy-mm-dd the placement runs (24h, that day)
  url       String? // the member's link AS SAVED when the day was earned; later edits don't rewrite an earned day
  createdAt DateTime @default(now())

  @@unique([userId, partner])
  @@index([date])
}

// ─── Traffic pool (Dave, 2026-11-19) ────────────────────────────────
// Every agent has a daily traffic pool (10 placement-slots per
// window, flat) and a brand behind it. The pool is worked through
// the rotator's free placements; this row is the recorded outcome
// for one agent in one SPOT WINDOW (lib/traffic-pool.ts) — reports
// count pool usage from here. Slots never roll over: a new window
// is a new row at 0. Since 2026-11-21 `date` stores the 23:50 ET
// spot-window KEY (the ET date the window opens on), not the
// placement's calendar date; pre-window rows were shifted −1 day
// by a one-time boot remap (scripts/apply-schema.ts).
model AgentTrafficDay {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  date      String // spot-window key: ET yyyy-mm-dd the window opens (23:50 ET)
  slotsUsed Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, date])
  @@index([userId, date])
}

// ─── Trending: the day's default topics ─────────────────────────────
// Dave's rule (2026-11-17): Trending settles on ONE default topic set
// per ET day instead of reloading the wire on every refresh. The first
// read of the day builds it (RSS topics + Starimg headlines in that
// language) and stores it here; every refresh that day serves this
// snapshot. One row per (ET day, language); the topic list itself is
// shared across languages — the first snapshot of the day fixes it.
model TrendDay {
  id         String   @id @default(cuid())
  date       String // ET calendar day, yyyy-mm-dd
  lang       String // headline language (topics are shared across langs)
  topicsJson String // JSON array of TrendTopic (headline + hook included)
  createdAt  DateTime @default(now())

  @@unique([date, lang])
}

// ─── Who's Calling? Doors — daily doors game (SPEC + Addenda v2/v3) ─────────
// One session per member per game day (America/New_York, 05:00 ET rollover).
// The prize assignment is server-only until the game finishes; commitmentHash
// is shown to the player from the moment they pick their keeper door.
model DoorsSession {
  id              String    @id @default(cuid())
  userId          String
  gameDate        String // YYYY-MM-DD (ET game day)
  language        String   @default("en")
  caller          String // joe | grandma | grandpa | young-mom | college-kid | shop-owner-mike
  keeperDoor      Int
  assignment      Json // door index -> prize (server-only until finished)
  commitmentHash  String
  state           String   @default("opening") // opening | banker1 | opening2 | banker2 | finished
  opened          Json     @default("[]") // door indices, in open order
  offers          Json     @default("[]") // {round, amount, decision}
  streak          Int      @default(0)
  bestStreak      Int      @default(0)
  peeksBanked     Int      @default(0)
  peeksUsed       Json     @default("[]") // door indices whose band was peeked
  sweatArmed      Boolean  @default(false) // Banker Sweat earned, applies to next offer
  calls           Json     @default("[]") // {door, band, correct} — Call It results
  readGuess       String? // keeper band guessed in Read the Banker
  result          Json? // {type: deal|keeper|dud, amount, gensAwarded, readBonus}
  prizeGensAwarded Int     @default(0)
  version         Int      @default(0) // optimistic-concurrency claim for state transitions (open/peek/read/decide)
  createdAt       DateTime @default(now())
  finishedAt      DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameDate])
  @@index([gameDate])
}

// The day's reveal set per language — generated once per language per day
// through the P&R engine (or the starter bank), never per player.
model DoorsDailySet {
  id        String   @id @default(cuid())
  gameDate  String
  language  String
  memes     Json // [{door, imageUrl, alt, caption, format}]
  status    String   @default("live") // live | starter | rerun
  createdAt DateTime @default(now())

  @@unique([gameDate, language])
}

// Append-only Bid Points ledger (auction currency). Balance = SUM(points).
// Kinds: REF_FINISH | REF_3DAYS | REF_CLAIM | BID_STAKE | BID_REFUND | BID_BURN
model BidPointEvent {
  id        String   @id @default(cuid())
  userId    String // the earner / bidder
  points    Int // signed
  kind      String
  refUserId String? // the referred member who triggered the event
  auctionId String?
  meta      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kind, refUserId])
  // Once-only referral awards: one REF_* event per (kind, referrer,
  // referred member), ever. BID_* rows carry refUserId NULL, which
  // SQLite treats as distinct, so stakes/refunds are unaffected.
  @@unique([kind, userId, refUserId])
}

// Weekly auction for one 10,000,000-token OpenAI-compatible key.
model KeyAuction {
  id         String    @id @default(cuid())
  weekKey    String    @unique // e.g. 2026-W47
  prizeLabel String
  opensAt    DateTime
  closesAt   DateTime
  status     String    @default("OPEN") // OPEN | CLOSED
  winnerId   String?
  winningBid Int?
  closedAt   DateTime?
  fulfilledAt DateTime? // manual key mint (Addendum v2 §A4)
  createdAt  DateTime  @default(now())
  winner     User?     @relation("KeyWins", fields: [winnerId], references: [id], onDelete: SetNull)
  bids       KeyBid[]
}

model KeyBid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auction   KeyAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId, points])
}

// ─── Static-page claim bridge ───────────────────────────────────────
// A win on a static page (no account there) arrives as a signed token
// (lib/claims.ts). Redemption is recorded once per token nonce — the
// unique nonce is the single-use lock — and pays free generations.
model ClaimRedemption {
  id        String   @id @default(cuid())
  nonce     String   @unique // the win token's one-time nonce
  userId    String // the member who claimed it
  amount    Int // free generations paid
  source    String // where the win happened (e.g. doors-static)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Voided claim nonces: W1 tokens are stateless, so killing an issued
// code means remembering its nonce forever. Redemption rejects any
// token whose nonce sits here (checked in lib/claims.ts). Rows are
// written by the boot-time agent-game purge (scripts/agentgame-purge.ts)
// before it deletes a test agent whose codes must die with it.
model ClaimVoidedNonce {
  nonce     String   @id // the voided win token's one-time nonce
  handle    String // whose token it was (e.g. the purged agent handle)
  reason    String // why it was voided (e.g. qa-test-cleanup)
  createdAt DateTime @default(now())
}

// ─── The Clipper ────────────────────────────────────────────────────
// A clipping page: one niche, one handle, a cadence. The editorial
// contract is `.agents/skills/clipping-agent/SKILL.md` in the engine
// repo; the four gates it describes are enforced in lib/clips/guards.ts.
//
// Ownership: these rows are the single queue of record. Agent37 is an
// executor that claims and reports (lib/clips/worker). Muse may create
// drafts and read the queue; only a signed-in click writes `approved`.

model ClipPage {
  id            String   @id @default(cuid())
  userId        String
  name          String // "GTA 6 Daily"
  handle        String // @gtadaily6
  niche         String // the one angle the page runs
  platforms     String   @default("[]") // json: ["tiktok","reels","shorts"]
  timezone      String   @default("UTC")
  approvalHours String? // "09:00-22:00" — nothing is approved outside it
  cadence       String   @default("{}") // json: {"tiktok":2,"reels":1}
  creatorAllow  String   @default("[]") // json: ["@studio"] — empty = any public source
  creatorBlock  String   @default("[]") // json: ["@handle"] — page-local refusals
  disclosure    String? // "Not affiliated with Rockstar Games"
  voiceStyle    String   @default("captions") // the clipping agent is captions, never a host
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips ClipJob[]

  @@index([userId])
}

model ClipJob {
  id            String   @id @default(cuid())
  userId        String
  pageId        String
  // draft | queued | rendering | ready | approved | exported | failed | blocked
  status        String   @default("draft")
  sourceUrl     String
  sourceKind    String // platform | media
  sourceHost    String // youtube.com, x.com, …
  clipSeconds   Int      @default(15)
  hook          String?
  caption       String?
  warnings      String   @default("[]") // json: engine QA warnings, verbatim
  pageUrl       String? // engine preview page
  mp4Url        String?
  creditWho     String? // @creator
  creditUrl     String? // the source the credit points at
  spoiler       Boolean  @default(false)
  series        String?
  episode       Int?
  engineJobId   String?
  bridgeTokenId String? // set when queued through the Muse bridge; the worker re-checks the token is live before charging
  fundingLane   String? // byok | paid | plan | paid-released — which clip lane this render reserved against
  grantId       String? // ClipCreditGrant the unit was drawn from (paid lane)
  attempts      Int      @default(0) // the worker retries once, then fails
  blockedReason String? // guard code + hint when status = blocked
  approvedAt    DateTime? // written only by the review desk
  exportedAt    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   ClipPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  credit ClipCredit?
  tokens ClipExportToken[]

  @@index([userId, status])
  @@index([pageId, createdAt])
}

// The credit ledger. A clip cannot reach `ready` without one — the
// engine's "🎬 @creator" placeholder fails the guard.
model ClipCredit {
  id         String   @id @default(cuid())
  userId     String
  clipId     String   @unique
  who        String // @creator
  url        String // where the clip came from
  verified   Boolean  @default(false) // a human checked it points at the source
  createdAt  DateTime @default(now())

  clip ClipJob @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A creator who asked to be removed. Global and permanent — not scoped
// to the page where they complained.
model ClipTakedown {
  id          String   @id @default(cuid())
  creator     String // handle, stored lowercased without @
  sourceUrl   String?
  note        String?
  requestedAt DateTime @default(now())

  @@unique([creator])
}

// The one-time export token minted by the approval click. The worker
// spends it; Muse never sees it. This is how `request_mp4` stays shut
// to everything except a human-approved job.
model ClipExportToken {
  id        String    @id @default(cuid())
  clipId    String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  clip ClipJob @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId])
}

// What actually went out. Logged by hand after the human posts it —
// never scraped, never inferred.
model ClipPost {
  id          String   @id @default(cuid())
  userId      String
  clipId      String
  platform    String
  externalUrl String?
  postedAt    DateTime @default(now())

  @@index([userId, postedAt])
}

// ─── The Box Trade (gamified clips) ─────────────────────────────────
// Buy a pack; that count is the floor, permanently. Each round reveals two
// upsides — extra clips or a brief — and the member takes one. Decline is
// free. Offers are derived from `seed` + `round` (lib/clips/game.ts), so a
// reload cannot fish for a better board: the same seed always deals the
// same two options.
model ClipGameSession {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  floor     Int // clips bought — the number that can never go down
  bonus     Int      @default(0)
  briefs    String   @default("[]") // json: BriefCard[]
  round     Int      @default(0)
  maxRounds Int      @default(3)
  seed      Int
  chosen    String   @default("[]") // json: 0 | 1 | -1 per round, for the audit trail
  status    String   @default("open") // open | resolved | abandoned
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ─── Clip credits and feedback ──────────────────────────────────────
// One visible balance, three sources. A grant is written when a pack is
// paid for (Whop webhook), when a member is given free credits at signup,
// or when a Box Trade resolves with bonus clips. Clips bought are never
// taken back at a month rollover — only the plan lane resets.
model ClipCreditGrant {
  id        String    @id @default(cuid())
  userId    String
  amount    Int // clips granted
  spent     Int       @default(0)
  source    String // purchase | free_grant | game_bonus | referral
  label     String? // what the member saw when it was granted
  reference String? // whop payment id / session id, for the audit trail
  expiresAt DateTime? // null = never expires
  spentAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, spentAt])
}

// What the member thought of a clip. This is opinion, not performance: it
// feeds the brief library and mnemos, and it is never reported as a result.
model ClipFeedback {
  id        String   @id @default(cuid())
  userId    String
  clipId    String
  verdict   String // good | meh | bad
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── App settings (operator-flippable, no redeploy) ─────────────────
// Tiny key-value store backing the site gate and per-stack status
// overrides (lib/site-gate.ts, lib/stacks.ts). Keys are namespaced
// strings ("site:gate", "stack:<id>:status"); values are plain text.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Telegram pairing (Dave, 2026-11-18) ─────────────────────────────
// One-time codes that bind a member's Telegram account (in the
// meme-loop-engine bot) to their Whoparmy account, so both surfaces
// share one Mnemos memory scope (member-<userId>). Same discipline
// as BridgeCode: only the SHA-256 hash is stored; the code is shown
// once. The bot consumes it server-to-server via
// POST /api/telegram/pair/verify behind TELEGRAM_PAIR_SECRET.
/**
 * Durable Telegram webhook dedupe: one row per (bot slug, update id)
 * that was SUCCESSFULLY handled. Replaces the in-process Set, which
 * forgot everything on restart and never deduped across instances.
 * A failed handler writes no row, so Telegram's retry can succeed.
 */
model TelegramUpdate {
  id        String   @id @default(cuid())
  botSlug   String
  updateId  Int
  createdAt DateTime @default(now())

  @@unique([botSlug, updateId])
  @@index([botSlug])
}

model TelegramPairCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── ATTRIBUTION SPINE A — identity binding (2026-11-21) ────────────
// One person = one Whop Army User (the root). Every other identifier
// is an ALIAS bound to that root here. An alias belongs to exactly one
// user, ever (@@unique([kind, value])): binding an already-bound alias
// to a different user is refused, never a silent rebind
// (lib/identity.ts). Written by Spine A: kind "telegram" (the Telegram
// user id as a string), by the pair-verify flow. Written by the Bankr
// connection slice (2026-11-21): "wallet_evm" (value = the EVM
// address, lowercased), "wallet_solana" (value = the base58 address,
// as-is) and "bankr_ref" (value = the Bankr referral code — the
// arrival identity for Bankr links). Still reserved, NOT written:
// "telegram_bot_ref", "agent_game", "wallet_btc" (BTC receive
// addresses live on the User BTC fields and are not duplicated here).
model IdentityLink {
  id         String    @id @default(cuid())
  userId     String
  kind       String // "telegram" | "wallet_evm" | "wallet_solana" | "bankr_ref"
  value      String // telegram: user id string · wallet_evm: lowercase address · wallet_solana: base58 · bankr_ref: ref code
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, value])
  @@index([userId])
}

// ─── BANKR CONNECTION — agent wallet binding (2026-11-21) ───────────
// The agent ↔ payout-address map for Bankr settlement. NOTE: earlier
// comments referred to an "AgentWallet" table as if it existed — it
// never did (the only wallet storage was the User BTC address
// fields, which are user-level, BTC-only, and carry no chain / agent
// / source semantics). This is that table, created by this slice.
// An address serves exactly ONE agent per chain
// (@@unique([chain, address])) so resolveWallet is deterministic;
// the owner is denormalized from the agent row at bind time. The
// user-level half of every binding is the IdentityLink above
// (lib/wallet-bind.ts writes both, and refuses when the address is
// bound to a different user). Addresses are PUBLIC receive addresses
// only — the app never holds keys and never moves money; settlement
// execution happens outside the server (operator + Bankr connector).
model AgentWallet {
  id         String    @id @default(cuid())
  agentId    String
  userId     String // owner, denormalized from HiredAgent.userId at bind time
  chain      String // "evm" | "solana"
  address    String // normalized: evm lowercased, solana base58 as-is
  source     String    @default("bankr") // "bankr" in this slice
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@unique([agentId, chain])
  @@index([userId])
}

// ─── BANKR CONNECTION — rotator split settlement ledger (2026-11-21) ─
// One settlement per confirmed rotator day (rotatorDayId unique).
// Dave's split: 25% Plunder & Riffle / 25% referrer / 50% agent
// owner, keyed by the agent's rotator sub-ID (the HiredAgent id the
// ?sub= stamp carries). Money stays SIMULATED: confirmed revenue is
// $0 and today's auction settles in free generations, so drafts are
// born simulated=true with grossCents=0 until an operator marks a
// real payable event. Status flow is operator-driven only:
// DRAFT → CONFIRMED → SETTLED (or VOID). Confirming produces a Bankr
// instruction packet; SETTLED only records the refs of an execution
// that happened OUTSIDE the server — the server never moves money
// and never claims it did.
model Settlement {
  id                 String    @id @default(cuid())
  date               String // ET calendar day, yyyy-mm-dd
  rotatorDayId       String?   @unique
  grossCents         Int       @default(0)
  currency           String    @default("USD")
  simulated          Boolean   @default(true)
  status             String    @default("DRAFT") // DRAFT | CONFIRMED | SETTLED | VOID
  referrerUnassigned Boolean   @default(false) // true when the winner's owner has no referrer — the 25% is recorded, never folded into another line
  notes              String?
  bankrJobId         String? // operator-recorded after executing via Bankr (outside the server)
  txRef              String? // operator-recorded transaction reference
  confirmedAt        DateTime?
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines SettlementLine[]

  @@index([date])
  @@index([status])
}

model SettlementLine {
  id            String  @id @default(cuid())
  settlementId  String
  role          String // PR | REFERRER | OWNER
  userId        String? // null on REFERRER when unassigned; null on PR until the house wallet is bound
  agentId       String? // the agent's rotator sub-ID (HiredAgent.id) when the win came through an agent
  walletAddress String? // resolved from bindings at build time; null = unbound (the packet refuses)
  chain         String? // "evm" | "solana" — the network walletAddress lives on
  amountCents   Int

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

// A referral captured BEFORE the recruit has a Whop account: a
// Telegram-first arrival binds the alias to the referrer here. First
// referrer wins — set-once, never overwritten (@@unique([kind,
// value])). When that person joins Whop and pairs their Telegram, the
// claim (lib/identity.ts claimPendingReferral) moves referrerId onto
// User.referredById — also set-once — and this row is consumed. No
// ReferralEarning is created here: earnings still fire from the
// existing conversion path once the recruit converts.
model PendingReferral {
  id         String   @id @default(cuid())
  kind       String // "telegram" in this slice
  value      String
  referrerId String
  createdAt  DateTime @default(now())

  referrer User @relation("PendingReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([kind, value])
  @@index([referrerId])
}

// ─── Pick a Phone (public game) ─────────────────────────────────────
// Anonymous public game sessions keep their assignment server-only until
// the game finishes; events provide the append-only audit trail.
model PickaphoneSession {
  id              String             @id @default(cuid())
  assignment      Json // phone slot (0-11) -> library asset id; server-only until finished
  commitmentHash  String
  state           String             @default("playing") // playing | offer | finished
  picks           Json               @default("[]") // slot indices in pick order
  bankedTokens    Int                @default(0) // Vault Tokens banked from reveals; only ever grows
  pendingOffer    Int? // offer milestone index awaiting a decision
  offers          Json               @default("[]") // {milestone, gens, decision} records
  streak          Int                @default(0) // current Call It read streak
  bestStreak      Int                @default(0)
  peeksBanked     Int                @default(0) // earned Peeks not yet spent (max 2)
  peeksUsed       Json               @default("[]") // {slot, band} — bands revealed by spent Peeks
  sweatArmed      Boolean            @default(false) // Host Sweat earned, applies to the next offer
  calls           Json               @default("[]") // {slot, call, correct} — Call It results
  readGuess       String? // Final Read lock: "HIGH" | "LOW" (final phone >= 100 VT?)
  pendingOfferTokens Int?           // effective Vault Token value of the pending offer (Host Sweat applied at presentation)
  pendingOfferSweat  Boolean        @default(false) // whether Host Sweat was applied to the pending offer
  finalTokens     Int?
  gensAwarded     Int                @default(0)
  claimNonce      String?            @unique // nonce of the minted W1 claim token (mint-once lock)
  claimToken      String? // the minted token, returned to the player exactly at finish
  version         Int                @default(0) // optimistic-concurrency claim, same pattern as DoorsSession
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?
  events          PickaphoneEvent[]

  @@index([createdAt])
}

model PickaphoneEvent {
  id         String             @id @default(cuid())
  sessionId  String
  type       String // game_start | phone_pick | reveal | call_it | peek_earned | peek_used | sweat_earned | sweat_applied | offer_presented | offer_accepted | offer_declined | final_read | game_finish | claim_minted
  payload    Json?
  createdAt  DateTime           @default(now())
  session    PickaphoneSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
}

model BtcgameSession {
  id              String          @id @default(cuid())
  assignment      Json // case slot (0-25) -> board tile id; server-only until finished
  commitmentHash  String
  state           String          @default("playing") // playing | offer | finished
  picks           Json            @default("[]") // slot indices in pick order
  bankedTokens    Int             @default(0) // Vault Tokens banked from reveals; only ever grows
  perks           Json            @default("[]") // {kind, slot} AGENT BOOST perks banked from reveals; fulfillment is a follow-up
  pendingOffer    Int? // offer milestone index awaiting a decision
  offers          Json            @default("[]") // {milestone, gens, decision} records
  finalTokens     Int?
  gensAwarded     Int             @default(0)
  claimNonce      String?         @unique // nonce of the minted W1 claim token (mint-once lock)
  claimToken      String? // the minted token, returned to the player exactly at finish
  version         Int             @default(0) // optimistic-concurrency claim, same pattern as DoorsSession
  createdAt       DateTime        @default(now())
  finishedAt      DateTime?
  events          BtcgameEvent[]

  @@index([createdAt])
}

model BtcgameEvent {
  id         String         @id @default(cuid())
  sessionId  String
  type       String // game_start | case_pick | reveal | offer_presented | offer_accepted | offer_declined | game_finish | claim_minted
  payload    Json?
  createdAt  DateTime       @default(now())
  session    BtcgameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
}

model AgentGameAgent {
  id             String            @id @default(cuid())
  handle         String            @unique // public agent id, chosen at registration
  name           String
  website        String?
  secretHash     String // SHA-256 of the agent secret; plaintext shown once at registration, never stored
  createdAt      DateTime          @default(now())
  lastActivityAt DateTime          @default(now())
  solves         AgentGameSolve[]
  attempts       AgentGameAttempt[]
  events         AgentGameEvent[]

  @@index([createdAt])
}

model AgentGameSolve {
  id          String         @id @default(cuid())
  agentId     String
  challengeId String
  gensAwarded Int            @default(0) // gens actually paid (0 when a cap blocked payment)
  claimNonce  String?        @unique // nonce of the minted W1 claim token (mint-once lock)
  claimToken  String? // the minted token, returned to the agent exactly at solve
  createdAt   DateTime       @default(now())
  agent       AgentGameAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, challengeId]) // a challenge pays once per agent
  @@index([createdAt]) // daily pool accounting
}

model AgentGameAttempt {
  id          String         @id @default(cuid())
  agentId     String
  challengeId String
  correct     Boolean
  createdAt   DateTime       @default(now())
  agent       AgentGameAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, challengeId])
}

model AgentGameEvent {
  id        String          @id @default(cuid())
  agentId   String?
  type      String // agent_registered | answer_wrong | challenge_solved | claim_minted
  payload   Json?
  createdAt DateTime        @default(now())
  agent     AgentGameAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([type])
  @@index([createdAt])
}

// ─── BTC Experiment — Real BTC (Dave, 2026-11-21) ────────────────────
// Internal rails only: a funding ledger, and payout batches Dave
// approves and pays from his OWN wallet. The app never holds keys,
// never generates wallets, never sends BTC — accounting, math, lists,
// and records. All money is integer sats; BTC decimals exist only at
// the input/display edge (lib/btc-payouts-logic.ts). Public surfaces
// keep their SIMULATION framing; nothing here changes public copy.

model BtcFundingEntry {
  id         String   @id @default(cuid())
  amountSats Int
  txid       String?
  note       String   @default("")
  createdAt  DateTime @default(now())
}

model BtcPayoutBatch {
  id        String          @id @default(cuid())
  // Sum of the batch's lines, recomputed on every line edit. The
  // undistributed remainder of a create request never lands here —
  // it stays in the ledger balance.
  totalSats Int
  status    String          @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  note      String          @default("") // the win / reference for this run
  txid      String? // required before the batch can be marked PAID
  createdAt DateTime        @default(now())
  paidAt    DateTime?
  lines     BtcPayoutLine[]
}

model BtcPayoutLine {
  id      String         @id @default(cuid())
  batchId String
  batch   BtcPayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Plain id, no FK: the line is a snapshot. The address below is the
  // member's saved address AT RUN CREATION — a later address change
  // never rewrites an existing run.
  userId     String
  address    String
  amountSats Int

  @@index([batchId])
}
